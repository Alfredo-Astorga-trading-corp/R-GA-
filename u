@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root {
  --bg: #07111f;
  --panel: rgba(15, 23, 42, 0.72);
  --panel-border: rgba(148, 163, 184, 0.2);
  --text: #e5eefb;
  --muted: #9fb3d9;
  --primary: #7c3aed;
  --secondary: #22d3ee;
  --accent: #f472b6;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(124, 58, 237, 0.35), transparent 30%),
    radial-gradient(circle at bottom right, rgba(34, 211, 238, 0.2), transparent 40%),
    linear-gradient(135deg, #020817 0%, #0b1120 50%, #111827 100%);
  min-height: 100vh;
}

.hero {
  padding: 6rem 1.5rem 3rem;
}

.glass {
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1px solid var(--panel-border);
  box-shadow: 0 20px 60px rgba(15, 23, 42, 0.45);
}

.card {
  border-radius: 22px;
  padding: 1.5rem;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.4));
  border: 1px solid rgba(148, 163, 184, 0.15);
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 24px 44px rgba(124, 58, 237, 0.2);
  border-color: rgba(124, 58, 237, 0.45);
}

.button-primary {
  border: none;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  font-weight: 700;
  padding: 0.95rem 1.5rem;
  border-radius: 999px;
  box-shadow: 0 18px 40px rgba(124, 58, 237, 0.4);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.button-primary:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 24px 50px rgba(34, 211, 238, 0.35);
}
